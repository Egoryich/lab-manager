# Append this site block to the EXISTING host Caddyfile.
# Replace the example domain. Keep the Headscale site unchanged.
lab.example.org {
    encode zstd gzip
    @api path /api /api/*
    handle @api {
        reverse_proxy 127.0.0.1:18000 {
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    handle {
        reverse_proxy 127.0.0.1:18080
    }
}
