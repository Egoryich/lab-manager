# Lab Manager owns this table only. The lmbr prefix is reserved for its guest bridges.
# This is a deny-only base: no guest may start until the full per-segment policy is applied.
# Replacing this table is one nftables transaction; unrelated Proxmox/Tailscale rules stay intact.
destroy table inet lab_manager
table inet lab_manager {
    chain guest_input {
        type filter hook input priority -10; policy accept;
        iifname "lmbr*" drop
    }

    chain guest_forward {
        type filter hook forward priority -10; policy accept;
        iifname "lmbr*" drop
        oifname "lmbr*" drop
    }

    chain guest_output {
        type filter hook output priority -10; policy accept;
        oifname "lmbr*" drop
    }
}
