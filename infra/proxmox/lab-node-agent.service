[Unit]
Description=Lab Manager read-only node inventory
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service pveproxy.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=lab-node-agent
Group=lab-node-agent
ExecStart=/opt/lab-manager-node/current/venv/bin/python -m lab_node_agent.service --config /etc/lab-manager-node/service.json
LoadCredential=proxmox-token.json:/etc/lab-manager/proxmox-token.json
LoadCredential=proxmox-ca.pem:/etc/pve/pve-root-ca.pem
LoadCredential=transport-ca.pem:/etc/lab-manager-node/tls/ca.pem
LoadCredential=server.pem:/etc/lab-manager-node/tls/server.pem
LoadCredential=server.key:/etc/lab-manager-node/tls/server.key
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
TasksMax=24
MemoryMax=128M
CPUQuota=25%
LimitNOFILE=128

[Install]
WantedBy=multi-user.target
