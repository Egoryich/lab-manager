LAB_REDIS_URL=redis://127.0.0.1:56379/0
LAB_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
LAB_DIGEST_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
POSTGRES_PASSWORD=REPLACE
