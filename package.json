{
  "name": "lab-manager",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/shared-types",
    "packages/client-sdk"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @lab/web",
    "build": "npm run build --workspace @lab/web",
    "typecheck": "npm run typecheck --workspace @lab/web",
    "generate": "openapi-typescript packages/shared-types/openapi.json -o packages/shared-types/src/schema.ts",
    "test:e2e": "playwright test",
    "check:docs": "node tools/validate-preparation.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "openapi-typescript": "^7.6.1",
    "prettier": "^3.9.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
